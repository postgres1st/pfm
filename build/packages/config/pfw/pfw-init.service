# pfw-init — first-boot provisioning (was supervisord [program:pmm-init],
# priority=-1). Type=oneshot + RemainAfterExit so the daemons order After= it
# and it stays "active (exited)" once done. Idempotent: safe to re-run every
# boot. Runs as the pfw service account (single-UID model, T1) because initdb
# and pg_stat_statements setup must NOT run as root.
[Unit]
Description=Postgres1st WatchTower first-boot provisioning (idempotent)
After=network.target
Before=pfw-postgresql.service pfw-clickhouse.service pfw-nginx.service pfw-grafana.service
RequiresMountsFor=/srv

[Service]
Type=oneshot
RemainAfterExit=yes
User=pfw
Group=pfw
# --- least-privilege sandbox (provisioner: writes across /srv and /run) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
# AF_NETLINK is required: pfw-init runs `pmm-agent setup`, whose node-address
# auto-detection enumerates interfaces via socket(AF_NETLINK); without it setup
# fails "required argument 'node-address' not provided" and aborts first boot.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# /srv (provisioning target) + only the pg socket dir under /run — NOT all of /run
# (which would expose /run/systemd, /run/dbus to the editable provisioning script).
ReadWritePaths=/srv /run/postgresql
# Create every provisioned file owner-only by default (single-UID pfw model), so
# secrets written then chmod'd (the PG superuser password, the nginx TLS key) are
# never briefly group-readable in the window before the explicit chmod.
UMask=0077
ExecStart=/usr/share/pfw/pfw-init.sh
# Hand the secret store to root, group pfw, AFTER pfw-init has generated it.
#
# systemd loads EnvironmentFile= in the child AFTER applying CapabilityBoundingSet
# but BEFORE dropping to User=. pfw-managed, pfw-grafana and pfw-qan-api2 all set an
# empty CapabilityBoundingSet, so that reader is root with no CAP_DAC_OVERRIDE and
# cannot read a pfw-owned 0600 file: the three units failed with "Failed to load
# environment files: Permission denied" and restarted forever. root:pfw 0640 lets
# root read as owner and pfw read via group, with no capability needed by either and
# no other local user able to.
#
# The `+` prefix runs this line as root even though the unit is User=pfw; pfw itself
# must not own the store, or the files it creates would be pfw-owned again.
#
# Docker cannot reproduce the failure this fixes: a privileged container keeps
# cap_dac_override in its bounding set, so every container suite read these files
# happily. See docs/beta2-release-readiness.md on native-only failures.
ExecStartPost=+/usr/share/pfw/pfw-secrets-perms.sh
# /dev/stdout is not openable under a systemd unit; send everything to journald.
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=pfw.target
