# pfw-agent — pfw's self-monitoring agent (was supervisord [program:pmm-agent],
# priority=15, autostart=false). Started ON DEMAND by pmm-managed once the
# control plane is ready (the code calls `systemctl start pfw-agent.service`,
# see systemdUnitName), NOT auto-started by pfw.target — mirroring upstream's
# autostart=false. Hence no [Install] section; PartOf=pfw.target still ties its
# stop/restart to the stack lifecycle.
#
# Its config is created by pfw-init.sh's `pmm-agent setup` step, under /srv
# (pfw-writable) rather than the container's root-owned /opt/postgres1st/watchtower path.
# PERCONA_TELEMETRY_DISABLE mirrors the image ENV lock.
[Unit]
Description=Postgres1st WatchTower self-monitoring agent (pfw-agent)
After=pfw-init.service pfw-managed.service
Requires=pfw-init.service
PartOf=pfw.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=pfw
Group=pfw
# --- least-privilege sandbox (NO egress block: pfw-agent connects to remote
# monitored databases, so IPAddressDeny would break monitoring) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
# AF_NETLINK: pfw-agent embeds nomad + vmagent, which enumerate network interfaces
# (socket(AF_NETLINK,…)); without it that fingerprinting fails EAFNOSUPPORT. Netlink
# is host-local, so this does not weaken the egress posture.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/srv/pfw-agent /srv/nomad /srv/logs
Environment=PERCONA_TELEMETRY_DISABLE=1
ExecStart=/usr/sbin/pfw-agent \
    --config-file=/srv/pfw-agent/config/pfw-agent.yaml \
    --paths-tempdir=/srv/pfw-agent/tmp
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
