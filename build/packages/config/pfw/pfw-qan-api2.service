# pfw-qan-api2 — Query Analytics API (was pmm-managed-generated
# [program:qan-api2], priority=13). Runtime values via EnvironmentFile
# (/run/pfw/qan-api2.env, written by pmm-managed — T3b):
#   QANAPI_DATA_RETENTION                         retention days (from settings)
#   PMM_CLICKHOUSE_ADDR/DATABASE/USER/PASSWORD    CH connection (already pure env)
# The PMM_CLICKHOUSE_* vars are read directly by qan-api2 (unchanged from the
# supervisord environment= block); T3b/T7 seeds defaults for first boot.
[Unit]
Description=Postgres1st WatchTower qan-api2 (Query Analytics API)
# NOTE: ordering After=pfw-managed does NOT protect the first-boot ClickHouse
# migration and was tried and removed. pfw-managed is Type=exec, so that ordering
# is satisfied the moment its process is exec'd -- it renders this unit's
# EnvironmentFile about 1.5s later, which is still mid-migration. The migration is
# instead protected by making the seeded default env byte-identical to what
# pfw-managed renders (see defaults/qan-api2.env), so it finds nothing to change
# and never restarts this service during first boot.
After=pfw-init.service pfw-clickhouse.service
Requires=pfw-init.service
PartOf=pfw.target
# Match supervisord startretries=1000 -> effectively unbounded; keep restarting.
StartLimitIntervalSec=0

[Service]
Type=exec
User=pfw
Group=pfw
# --- least-privilege sandbox + zero-egress (validated on the real stack) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/logs
IPAddressDeny=any
IPAddressAllow=localhost
EnvironmentFile=/run/pfw/qan-api2.env
# The generated ClickHouse credential, read straight from the secret store rather
# than through pfw-managed's render. It must NOT travel in /run/pfw/*.env: that
# file's seeded default has to stay byte-identical to what pfw-managed renders, or
# the first render differs, systemd reload-or-restarts this unit ~1.5s into boot,
# and qan-api2's ClickHouse migration is interrupted and left dirty -- unrecoverable
# without manual intervention. See the note at the top of pfw-qan-api2.service.
EnvironmentFile=/srv/.pfw-secrets/clickhouse.env
# Wait for ClickHouse to actually accept connections. After= only orders against
# pfw-clickhouse's Type=exec, which is satisfied the moment the binary is exec'd
# -- well before port 9000 is listening. Without this gate qan-api2 starts its
# schema migration against a not-yet-ready server, dies partway, and leaves
# schema_migrations marked dirty ("Dirty database version N. Fix and force
# version."), which it can NEVER recover from on its own: the unit then restart
# loops forever and readyz stays 504. Bash's /dev/tcp is used deliberately -- the
# sandbox permits AF_INET to localhost and it needs no extra binary in the image.
ExecStartPre=/bin/bash -c 'until (exec 3<>/dev/tcp/127.0.0.1/9000) 2>/dev/null; do sleep 1; done'
ExecStart=/usr/sbin/pfw-qan-api2 \
    --data-retention=${QANAPI_DATA_RETENTION}
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfw.target
