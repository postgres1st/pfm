# pfw-grafana — dashboards UI (was supervisord [program:grafana], priority=3).
# NOTE: grafana is a "static daemon" only for the T0 skeleton. Its real config
# (server.domain + the PMM_POSTGRES_*/PMM_CLICKHOUSE_* env that point it at the
# embedded PG backend) is REGENERATED by pmm-managed at runtime. In the
# native model pmm-managed (T3) writes those into the drop-in EnvironmentFile
# referenced below; pfw-tmpfiles.conf seeds it (with the zero-egress phone-home
# disables) on every boot so it is present before the first render.
[Unit]
Description=Postgres1st WatchTower Grafana (dashboards)
After=pfw-init.service pfw-postgresql.service
Requires=pfw-init.service
PartOf=pfw.target
# Retry indefinitely: grafana's DB credentials are generated at first-boot and
# only written to its EnvironmentFile by pmm-managed at runtime, so it must keep
# restarting until that render lands rather than hit a permanent start limit.
StartLimitIntervalSec=0

[Service]
Type=exec
User=pfw
Group=pfw
WorkingDirectory=/usr/share/grafana
# --- least-privilege sandbox + zero-egress (validated on the real stack) ---
# NOTE: HA (unified alerting gossip) reaches remote peers; when HA is enabled the
# operator must widen IPAddressAllow to the peer addresses. Default (no HA) is loopback-only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/grafana /srv/logs
IPAddressDeny=any
IPAddressAllow=localhost
# Seeded by pfw-tmpfiles.conf (zero-egress disables) and regenerated by
# pmm-managed (T3). Non-optional: this file is the sole carrier of grafana's
# egress controls, so a seed failure must fail the unit closed, not boot it with
# phone-homes re-enabled.
EnvironmentFile=/run/pfw/grafana.env
# Generated credentials, listed after the pmm-managed render so they win: systemd
# reads EnvironmentFile= in declaration order and a later assignment overrides an
# earlier one. pmm-managed's grafana template emits no GF_DATABASE_* or
# GF_SECURITY_* key (systemd.go:157-183), so nothing here is clobbered by a render.
EnvironmentFile=/srv/.pfw-secrets/grafana.env
# The generated ClickHouse credential, read straight from the secret store rather
# than through pfw-managed's render. It must NOT travel in /run/pfw/*.env: that
# file's seeded default has to stay byte-identical to what pfw-managed renders, or
# the first render differs, systemd reload-or-restarts this unit ~1.5s into boot,
# and qan-api2's ClickHouse migration is interrupted and left dirty -- unrecoverable
# without manual intervention. See the note at the top of pfw-qan-api2.service.
EnvironmentFile=/srv/.pfw-secrets/clickhouse.env
ExecStart=/usr/sbin/grafana server \
    --homepath=/usr/share/grafana \
    --config=/etc/grafana/pfw.ini
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfw.target
