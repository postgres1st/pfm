# pfm — native systemd stack (path B). Groups the per-service units so the
# whole server starts/stops as one: `systemctl start pfm.target`.
# T0 authors the static daemons; the dynamic services (victoriametrics,
# vmalert, vmproxy, qan-api2) and the control plane (pmm-managed, pmm-agent)
# are added by T2/T3 and will append themselves to Wants= below.
[Unit]
Description=pfm monitoring server
Requires=pfm-init.service
After=pfm-init.service
Wants=pfm-postgresql.service pfm-clickhouse.service pfm-nginx.service pfm-grafana.service

[Install]
WantedBy=multi-user.target
