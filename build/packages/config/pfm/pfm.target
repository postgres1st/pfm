# pfm — native systemd stack (path B). Groups the per-service units so the
# whole server starts/stops as one: `systemctl start pfm.target`.
# Static daemons + first-boot init, the dynamic services (victoriametrics,
# vmalert, vmproxy, qan-api2), and the control plane (pmm-managed). pfm-agent is
# deliberately NOT wanted here — pmm-managed starts it on demand once the server
# is ready (mirrors upstream autostart=false).
[Unit]
Description=pfm monitoring server
Requires=pfm-init.service
After=pfm-init.service
Wants=pfm-postgresql.service pfm-clickhouse.service pfm-nginx.service pfm-grafana.service
Wants=pfm-victoriametrics.service pfm-vmalert.service pfm-vmproxy.service pfm-qan-api2.service
Wants=pfm-managed.service

[Install]
WantedBy=multi-user.target
