// Installed to /usr/share/polkit-1/rules.d/49-pfm.rules by the pfm-server RPM.
//
// Let the non-root pfm service account start/stop/restart/reload ONLY pfm-*
// units, so pmm-managed (User=pfm) can reload the dynamic services after an env
// re-render, start pfm-agent, and stop the embedded VM. Without this, every
// systemctl call from pmm-managed fails with polkit "Access denied".
//
// SECURITY: only the manage-units action is granted, and only for pfm-*/pfm.target
// units — that action carries the target unit, so it can be scoped. The
// manage-unit-files action (mask / unmask / enable / disable / LINK / preset) is
// deliberately NOT granted: systemd exposes NO per-unit detail on it, so it cannot
// be scoped to pfm-*, and granting it would let a compromised pfm process `link` an
// attacker-authored unit and `start` it as root (the unit name matches the pfm-
// prefix). pmm-managed therefore does not use mask/unmask at all — it disables the
// embedded VM with a ConditionPathExists marker file instead (see systemd.go's
// disableDynamicService).
function pfmUnit(u) {
    return u && (u.indexOf("pfm-") === 0 || u === "pfm.target");
}

polkit.addRule(function(action, subject) {
    if (subject.user !== "pfm") {
        return;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" && pfmUnit(action.lookup("unit"))) {
        return polkit.Result.YES;
    }
    // Everything else (incl. all manage-unit-files ops) falls through to the
    // systemd default (auth_admin) — denied for the headless pfm account.
});
