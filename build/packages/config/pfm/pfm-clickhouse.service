# pfm-clickhouse — QAN storage (was supervisord [program:clickhouse],
# priority=2). config.xml currently logs to console; under systemd that maps
# cleanly to journald via StandardOutput=journal. If ClickHouse is configured
# to open /dev/stdout as a file it will fail here -- switching its log config
# to <console>1</console> / journald is a T5 (logging-redirect) item, not T0.
[Unit]
Description=pfm ClickHouse (QAN storage)
After=pfm-init.service pfm-clickhouse-perms.service
# Requires, not just After: if the ownership repair fails, starting
# ClickHouse would only fail more confusingly.
Requires=pfm-clickhouse-perms.service
Requires=pfm-init.service
PartOf=pfm.target
# Match supervisord startretries=10 (systemd default is 5/10s).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=pfm
Group=pfm
# --- least-privilege sandbox + zero-egress (validated on the real stack) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/clickhouse /srv/logs /run/clickhouse-server
IPAddressDeny=any
IPAddressAllow=localhost
ExecStart=/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/config.xml
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfm.target
