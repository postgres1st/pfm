# pfm-clickhouse — QAN storage (was supervisord [program:clickhouse],
# priority=2). config.xml currently logs to console; under systemd that maps
# cleanly to journald via StandardOutput=journal. If ClickHouse is configured
# to open /dev/stdout as a file it will fail here -- switching its log config
# to <console>1</console> / journald is a T5 (logging-redirect) item, not T0.
[Unit]
Description=pfm ClickHouse (QAN storage)
After=pfm-init.service pfm-clickhouse-perms.service
# Requires, not just After: if the ownership repair fails, starting
# ClickHouse would only fail more confusingly.
Requires=pfm-clickhouse-perms.service
Requires=pfm-init.service
PartOf=pfm.target
# Match supervisord startretries=10 (systemd default is 5/10s).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=pfm
Group=pfm
# --- least-privilege sandbox + zero-egress (validated on the real stack) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# clickhouse-common-static's %post puts file capabilities on the binary:
#   cap_net_bind_service,cap_net_admin,cap_ipc_lock,cap_sys_nice=ep
# execve() returns EPERM when a file's PERMITTED set is not a subset of the bounding
# set, so `CapabilityBoundingSet=` (empty) here made the binary unexecutable on a
# native RHEL host -- 203/EXEC, and qan-api2 then hung in start-pre forever waiting
# on port 9000. Docker tolerated it, so both container suites stayed green.
#
# This list is a CEILING, not a grant. NoNewPrivileges=yes above suppresses the file
# capabilities entirely: the process runs with CapPrm=CapEff=0, and ClickHouse says
# so itself ("no CAP_IPC_LOCK capability, binary mlock will be disabled"). Verified
# on RHEL 9.8 -- with NoNewPrivileges=no the same unit really does gain all four.
#
# ---> These two directives are a PAIR. Dropping NoNewPrivileges=yes silently turns
#      this ceiling into a real grant of CAP_NET_ADMIN and friends.
# p_ch_caps_within_bounding_set guards the other direction: an upstream clickhouse
# that adds a fifth capability must be caught here, not by a customer.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_IPC_LOCK CAP_SYS_NICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/clickhouse /srv/logs
# /run/clickhouse-server is NOT in ReadWritePaths -- systemd creates it for us here,
# on every start, and makes it writable automatically.
#
# It used to be listed there and created only by our tmpfiles entry, which runs at
# boot. But /run is tmpfs and this directory is not ours alone: the distro
# clickhouse-server.service declares RuntimeDirectory=clickhouse-server with the
# default RuntimeDirectoryPreserve=no, so systemd DELETES /run/clickhouse-server every
# time that unit stops. After anything cycles it, our unit could no longer start --
# "Failed at step NAMESPACE ... No such file or directory", 226/NAMESPACE.
#
# The failure hid: an already-running ClickHouse kept serving, because its mount
# namespace bound the directory at start. The host looked healthy while the service
# had silently become unrestartable, surfacing at the next restart -- typically an
# upgrade, which is the worst time to discover it.
#
# Preserve=yes so OUR stop does not delete the directory out from under the distro
# unit -- inflicting the same bug in the opposite direction.
RuntimeDirectory=clickhouse-server
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
IPAddressDeny=any
IPAddressAllow=localhost
ExecStart=/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/config.xml
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfm.target
