# pfm first-boot defaults for pfm-victoriametrics.service, seeded to
# /run/pfm/victoriametrics.env by tmpfiles.d. pmm-managed overwrites these with
# the live, settings-driven values once it starts (see systemd.go envTemplates).
VM_retentionPeriod=30d
VM_search_disableCache=false
PMM_BIND_ADDRESS=127.0.0.1
