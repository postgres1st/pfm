# pfm first-boot defaults for pfm-grafana.service (seeded by tmpfiles.d).
# Carries the zero-egress phone-home disables from the very first boot and the
# grafana DB creds pfm-init.sh creates. pmm-managed overwrites these once it
# starts (systemd.go envTemplates renders the same keys).
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
GF_SNAPSHOTS_EXTERNAL_ENABLED=false
GF_PLUGINS_PLUGIN_ADMIN_ENABLED=false
PMM_POSTGRES_ADDR=127.0.0.1:5432
PMM_POSTGRES_DBNAME=grafana
PMM_POSTGRES_USERNAME=grafana
PMM_POSTGRES_DBPASSWORD=grafana
PMM_POSTGRES_SSL_MODE=disable
PMM_CLICKHOUSE_HOST=127.0.0.1
PMM_CLICKHOUSE_PORT=9000
PMM_CLICKHOUSE_USER=default
PMM_CLICKHOUSE_PASSWORD=clickhouse
