# pfm-nginx — TLS/reverse proxy (was supervisord [program:nginx], priority=4).
# supervisord required a foreground process, so the native nginx.conf sets
# `daemon off;`. We force it here with `-g 'daemon off;'` so the unit is correct
# regardless of the conf, and use Type=exec. stopwaitsecs=10 -> TimeoutStopSec.
# The native nginx.conf (build/packages/config/pfm/nginx/) already fixes the pid
# path and error_log for the non-root pfm user; `-e /dev/stderr` additionally
# routes nginx's *startup* error log (opened before the conf's error_log takes
# effect) to the journal, so a non-root master doesn't fail opening the compiled-in
# /var/log/nginx/error.log.
[Unit]
Description=pfm nginx (TLS reverse proxy)
After=pfm-init.service
Requires=pfm-init.service
PartOf=pfm.target
# Match supervisord startretries=10 (systemd default is 5/10s).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=pfm
Group=pfm
# --- least-privilege sandbox (NO egress block: nginx is the TLS ingress and must
# accept connections from any client) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/nginx /run/nginx
# Replaces `worker_rlimit_nofile 65535` in nginx.conf: nginx implements that with
# setrlimit(), which our confined httpd_t domain is denied unless the global
# httpd_setrlimit boolean is set. That denial is silent and non-fatal -- workers fall
# back to 1024 descriptors. systemd raises the limit before exec, so nginx never calls
# setrlimit and the boolean stays off.
LimitNOFILE=65535
# -c /etc/nginx/pfm.conf: the base nginx package owns /etc/nginx/nginx.conf, so the
# pfm config ships beside it as pfm.conf and is selected explicitly here.
ExecStart=/usr/sbin/nginx -c /etc/nginx/pfm.conf -e stderr -g 'daemon off;'
ExecReload=/usr/sbin/nginx -c /etc/nginx/pfm.conf -e stderr -s reload
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfm.target
