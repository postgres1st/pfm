# pfm-nginx — TLS/reverse proxy (was supervisord [program:nginx], priority=4).
# supervisord required a foreground process, so the image's nginx.conf sets
# `daemon off;`. We force it here with `-g 'daemon off;'` so the unit is correct
# regardless of the conf, and use Type=exec. stopwaitsecs=10 -> TimeoutStopSec.
# The image's `error_log /dev/stdout` / pid path fixes are a T5 item.
[Unit]
Description=pfm nginx (TLS reverse proxy)
After=pfm-init.service
Requires=pfm-init.service
PartOf=pfm.target

[Service]
Type=exec
User=pfm
Group=pfm
ExecStart=/usr/sbin/nginx -g 'daemon off;'
ExecReload=/usr/sbin/nginx -s reload
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfm.target
