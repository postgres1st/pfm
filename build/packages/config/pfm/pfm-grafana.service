# pfm-grafana — dashboards UI (was supervisord [program:grafana], priority=3).
# NOTE: grafana is a "static daemon" only for the T0 skeleton. Its real config
# (server.domain + the PMM_POSTGRES_*/PMM_CLICKHOUSE_* env that point it at the
# embedded PG backend) is REGENERATED by pmm-managed at runtime. In the
# native model pmm-managed (T3) writes those into the drop-in EnvironmentFile
# referenced below; until then the "-" prefix makes the missing file non-fatal
# so the process still launches under systemd (the T0 gate).
[Unit]
Description=pfm Grafana (dashboards)
After=pfm-init.service pfm-postgresql.service
Requires=pfm-init.service
PartOf=pfm.target
# Match supervisord startretries=10 (systemd default is 5/10s).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=pfm
Group=pfm
WorkingDirectory=/usr/share/grafana
# Populated by pmm-managed's config regen (T3); optional at T0.
EnvironmentFile=-/run/pfm/grafana.env
ExecStart=/usr/sbin/grafana server \
    --homepath=/usr/share/grafana \
    --config=/etc/grafana/grafana.ini
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfm.target
