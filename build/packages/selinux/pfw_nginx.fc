# File contexts for the Postgres1st WatchTower layout.
#
# restorecon picks the most specific match, not the last line, so the tmp rule below
# wins over the broader /srv/nginx one regardless of ordering here.
#
# Service DATA under /srv (postgresql, clickhouse, grafana, victoriametrics) is left
# var_t on purpose: those services run as unconfined_service_t, so relabelling their
# data would be churn with no security benefit and a real risk of breaking them.
#
# That argument is about the SERVICE's domain, and it does not extend to every file a
# service depends on. It was originally written as "the rest of /srv is left var_t",
# which is how /srv/.pfw-secrets came to be var_t and the product could not boot on an
# enforcing host: EnvironmentFile= is read by PID 1 as init_t -- a confined domain --
# no matter how unconfined the service itself is. The question to ask of a path here
# is not "is the service confined?" but "which domain opens this file?".

/srv/nginx(/.*)?        gen_context(system_u:object_r:pfw_cert_t,s0)
/srv/nginx/tmp(/.*)?    gen_context(system_u:object_r:pfw_nginx_tmp_t,s0)

# Read by PID 1 (init_t) via EnvironmentFile=, not by the services. See pfw_nginx.te.
/srv/\.pfw-secrets(/.*)?    gen_context(system_u:object_r:pfw_secret_t,s0)
