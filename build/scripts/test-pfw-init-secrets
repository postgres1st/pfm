#!/usr/bin/env bash
# Host-history tests for pfw-init.sh's bootstrap credential logic.
#
#   build/scripts/test-pfw-init-secrets
#
# Unlike test-pfw-airgap and test-pfw-upgrade, this needs NO built bundle, no
# container and no root: it sources pfw-init.sh as a library with SRV and the
# ClickHouse XML path redirected into a temp directory, and drives the credential
# functions directly. That makes the decision table runnable on any developer box
# and in CI, where the container suites are not.
#
# What it covers is the part of this logic that is pure decision-making -- which
# credential a given host history should end up with -- because that is where the
# defects have actually been. It does NOT cover: systemd wiring, file ownership as
# root, SELinux labels, or whether ClickHouse and PostgreSQL accept the values. Those
# stay with the container suites and the native VM run.
#
# Each case states the host history it represents, because "provisioned" alone is
# ambiguous and getting that wrong is precisely how a generated credential can be
# silently overwritten with the shipped constant.
set -o errexit
set -o nounset
set -o pipefail

cd "$(dirname "$0")/../.."
INIT=build/packages/config/pfw/pfw-init.sh
LEGACY_CH_HASH=7e099f39b84ea79559b3e85ea046804e63725fd1f46b37f281276aae20f86dc3

pass=0; fail=0
ok() { printf '  \033[32mPASS\033[0m  %s\n' "$*"; pass=$((pass + 1)); }
no() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; fail=$((fail + 1)); }

# mk_host <dir> [clickhouse-hash] -- build a throwaway /srv plus a library copy of
# pfw-init.sh with SRV and the ClickHouse XML paths redirected into it. The `main
# "$@"` line is stripped so sourcing defines the functions without provisioning
# anything.
mk_host() {
    local root=$1 hash=${2:-}
    mkdir -p "${root}/srv" "${root}/etc/clickhouse-server"
    sed -e '/^main "\$@"$/d' \
        -e "s#^readonly SRV=/srv\$#readonly SRV=${root}/srv#" \
        -e "s#^readonly CLICKHOUSE_USERS_XML=.*#readonly CLICKHOUSE_USERS_XML=${root}/etc/clickhouse-server/default-users.xml#" \
        -e "s#^readonly CLICKHOUSE_LOWMEM_USERS_XML=.*#readonly CLICKHOUSE_LOWMEM_USERS_XML=${root}/etc/clickhouse-server/low-memory-users.xml#" \
        "${INIT}" > "${root}/lib.sh"
    if [ -n "${hash}" ]; then
        printf '<password_sha256_hex>%s</password_sha256_hex>\n' "${hash}" \
            > "${root}/etc/clickhouse-server/default-users.xml"
    fi
}

# provisioned <dir> -- mark the host as one that has completed provisioning before.
provisioned() { printf 'native' > "$1/srv/pfw-distribution"; }
# A host provisioned before the rebrand has only the old sentinel. srv_provisioned()
# accepts either, and this is what proves it -- without it the rename would read as
# "never provisioned" and provision_srv() would re-run initdb over a real cluster.
provisioned_legacy() { printf 'native' > "$1/srv/pmm-distribution"; }

# generated <dir> -- mark the host as one whose credentials were generated here.
generated() { printf 'x' > "$1/srv/pfw-secrets-generated"; }

secret() { sed -n "s/^$2=//p" "$1/srv/.pfw-secrets/$3" 2>/dev/null; }

run() { # run <dir> <function> -- returns the function's exit status, output hidden
    ( set +e; source "$1/lib.sh" >/dev/null 2>&1
      install -d -m 0700 "$1/srv/.pfw-secrets" >/dev/null 2>&1
      "$2" >/dev/null 2>&1 )
}

H=$(mktemp -d); trap 'rm -rf "${H}"' EXIT

printf '\n>>> PostgreSQL credentials (ensure_secrets)\n'

# A host installed fresh by this build: nothing provisioned yet, so both roles are
# about to be created and must get generated values.
d="${H}/pg-fresh"; mk_host "${d}"
if run "${d}" ensure_secrets; then
    m=$(secret "${d}" PMM_POSTGRES_DBPASSWORD managed-db.env)
    g=$(secret "${d}" GF_DATABASE_PASSWORD grafana.env)
    a=$(secret "${d}" GF_SECURITY_ADMIN_PASSWORD grafana.env)
    [[ ${m} =~ ^[0-9a-f]{32}$ && ${g} =~ ^[0-9a-f]{32}$ && ${a} =~ ^[0-9a-f]{32}$ ]] \
        && [ "${m}" != "${g}" ] && [ "${g}" != "${a}" ] \
        && ok "fresh install generates three distinct credentials" \
        || no "fresh install: expected three distinct hex credentials, got m=${m} g=${g} a=${a}"
else
    no "fresh install: ensure_secrets failed"
fi

# A host provisioned by a build that predates the secret store. Its roles still hold
# the historical constants, so relocation must preserve them EXACTLY -- generating
# here would lock the server out of its own database.
d="${H}/pg-legacy"; mk_host "${d}"; provisioned "${d}"
if run "${d}" ensure_secrets; then
    m=$(secret "${d}" PMM_POSTGRES_DBPASSWORD managed-db.env)
    g=$(secret "${d}" GF_DATABASE_PASSWORD grafana.env)
    [ "${m}" = pmm-managed ] && [ "${g}" = grafana ] \
        && ok "legacy host relocates the historical constants unchanged" \
        || no "legacy host: expected the constants, got m=${m} g=${g}"
    [ -z "$(secret "${d}" GF_SECURITY_ADMIN_PASSWORD grafana.env)" ] \
        && ok "legacy host is not given an admin password (Grafana would ignore it)" \
        || no "legacy host: wrote GF_SECURITY_ADMIN_PASSWORD, which is inert and misleading"
else
    no "legacy host: ensure_secrets failed"
fi

# A host this build provisioned, whose secret store was then lost -- `cp -r /srv/*`,
# tar/rsync without '.[!.]*', an operator cleanup. The roles still hold generated
# passwords, so writing the constants would rotate pmm-managed BACK to a public value
# via initWithRoot's ALTER USER. This must refuse.
d="${H}/pg-lost"; mk_host "${d}"; provisioned "${d}"; generated "${d}"
if run "${d}" ensure_secrets; then
    no "lost secret store: ensure_secrets succeeded; it must refuse rather than write the constant"
else
    [ -z "$(secret "${d}" PMM_POSTGRES_DBPASSWORD managed-db.env)" ] \
        && ok "lost secret store refuses, and writes no constant" \
        || no "lost secret store: refused but still wrote a credential"
fi

printf '\n>>> ClickHouse credential (ensure_clickhouse_secret)\n'

# Upgraded host whose deployed XML still carries sha256("clickhouse"): the server
# accepts the constant, so relocating it is correct.
d="${H}/ch-legacy"; mk_host "${d}" "${LEGACY_CH_HASH}"; provisioned "${d}"
if run "${d}" ensure_clickhouse_secret; then
    [ "$(secret "${d}" PMM_CLICKHOUSE_PASSWORD clickhouse.env)" = clickhouse ] \
        && ok "legacy ClickHouse hash relocates the constant" \
        || no "legacy ClickHouse hash: expected the constant"
else
    no "legacy ClickHouse hash: refused when it should have relocated"
fi

# Host whose ClickHouse password was generated (any other hash) but whose secret is
# gone. Writing the constant would leave every consumer unable to authenticate.
d="${H}/ch-generated"; mk_host "${d}" "aaaa1111bbbb2222cccc3333dddd4444eeee5555ffff6666aaaa7777bbbb8888"; provisioned "${d}"
if run "${d}" ensure_clickhouse_secret; then
    no "generated ClickHouse hash with no secret: succeeded; it must refuse"
else
    [ -z "$(secret "${d}" PMM_CLICKHOUSE_PASSWORD clickhouse.env)" ] \
        && ok "generated ClickHouse hash with a lost secret refuses to write the constant" \
        || no "generated ClickHouse hash: refused but still wrote the constant"
fi

# No ClickHouse config deployed at all. Not fatal -- %post's first-install branch may
# legitimately have been skipped -- but it must not silently look fine either.
d="${H}/ch-noxml"; mk_host "${d}"; provisioned "${d}"
if run "${d}" ensure_clickhouse_secret; then
    [ -z "$(secret "${d}" PMM_CLICKHOUSE_PASSWORD clickhouse.env)" ] \
        && ok "absent ClickHouse XML writes nothing rather than guessing" \
        || no "absent ClickHouse XML: invented a credential"
else
    no "absent ClickHouse XML: exited non-zero; this must not kill first boot"
fi

# Re-running must never disturb an existing value: pfw-init runs on EVERY boot.
d="${H}/ch-idem"; mk_host "${d}" "${LEGACY_CH_HASH}"; provisioned "${d}"
run "${d}" ensure_clickhouse_secret || true
printf 'PMM_CLICKHOUSE_PASSWORD=already-set\n' > "${d}/srv/.pfw-secrets/clickhouse.env"
run "${d}" ensure_clickhouse_secret || true
[ "$(secret "${d}" PMM_CLICKHOUSE_PASSWORD clickhouse.env)" = already-set ] \
    && ok "an existing ClickHouse secret is never overwritten" \
    || no "an existing ClickHouse secret was overwritten"

printf '\n%s passed, %s failed\n' "${pass}" "${fail}"
[ "${fail}" -eq 0 ]
