#!/bin/bash
set -o errexit
set -o xtrace

. "$(dirname $0)"/vars

# 1st-party
"${bin_dir}/build-server-rpm" percona-dashboards pmm
"${bin_dir}/build-server-rpm" pfm-managed pmm
"${bin_dir}/build-server-rpm" percona-qan-api2 pmm
"${bin_dir}/build-server-rpm" pmm-dump
"${bin_dir}/build-server-rpm" vmproxy pmm

# 3rd-party
"${bin_dir}/build-server-rpm" victoriametrics
"${bin_dir}/build-server-rpm" grafana

# assembly: native systemd server package (units, config, first-boot provisioning).
# Built last — it packages the pfm control-plane over the components above.
"${bin_dir}/build-server-rpm" pfm-server pmm

# vim: expandtab shiftwidth=4 tabstop=4
