#!/usr/bin/env bash
# Negative control for the assertions in BOTH bundle test suites.
#
#   build/scripts/test-pfw-negative-control [airgap|upgrade|both]   (default: both)
#
# A green test suite is not evidence. It becomes evidence once each assertion has
# been shown to go RED when the thing it guards is actually broken. This breaks
# them, one at a time, and requires each to notice.
#
# It is not hypothetical: the first control ever run here found a false pass. The
# assertion "the repair unit brought the server back (readyz 200)" stayed green with
# pfw-clickhouse-perms masked, because ClickHouse limps rather than dying -- it keeps
# serving queries while ConfigReloader fails every second on a config it cannot read.
# That assertion proved nothing and was replaced.
#
# Each control runs the predicate three times:
#
#   1. baseline  -- must be GREEN, or the control cannot say anything
#   2. broken    -- must be RED; if it stays green the assertion is decorative
#   3. restored  -- must be GREEN again, or the control left the host dirty
#
# Two classes of control, counted and printed separately because they are not equally
# strong evidence:
#
#   state break      -- change the host so the guarded property is genuinely false.
#                       Proves the assertion is wired to real state AND discriminates.
#   [input]          -- call the same predicate with a known-bad ARGUMENT. Proves it
#                       discriminates, but NOT that the suite aims it at the right
#                       target. Only for properties that cannot be broken safely.
#
# The predicates are sourced from the suites themselves (PFW_LIB_ONLY=1), NOT
# reimplemented. Controlling a copy of an assertion would prove nothing about the
# assertion that actually runs.
#
# The two suites describe different hosts, so each phase needs the container left
# behind by its own suite (default PFW_TEST_KEEP=1 does that): pfw-airgap-test from
# test-pfw-airgap, pfw-upgrade-test from test-pfw-upgrade. It mutates those
# containers and restores as it goes, so run it against throwaway hosts, never a real
# one.
set -o errexit
set -o nounset
set -o pipefail

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
scratch=$(mktemp -d)
trap 'rm -rf "${scratch}"' EXIT

# Which suite(s) to control. The two suites describe DIFFERENT hosts -- a fresh
# install and an upgraded one -- so each phase points ${container} at its own.
phase=${1:-both}
# Clear positional args before sourcing: the suites read $1 as their repo path, and
# passing "airgap" through would send them looking for a bundle called "airgap".
set --

PFW_LIB_ONLY=1
export PFW_LIB_ONLY
# shellcheck source=/dev/null
source "${bin_dir}/test-pfw-airgap"
airgap_container=${container}
# shellcheck source=/dev/null
source "${bin_dir}/test-pfw-upgrade"
upgrade_container=${container}

controlled=0; weak=0; skipped=0; state_broken=0; input_fed=0

hdr() { printf '\n\033[1m%s\033[0m\n' "$*"; }
note() { printf '  \033[33mNOTE\033[0m  %s\n' "$*"; }
skip() { printf '  \033[33mSKIP\033[0m  %s\n' "$*"; skipped=$((skipped+1)); }

# ctl <label> <predicate expression> <break> <restore> [budget-seconds]
# The predicate expression is eval'd, so "! p_foo" expresses an inverted assertion.
#
# POLLS rather than sleeping a fixed time and checking once. Several breaks land
# asynchronously -- `docker network connect` installs the default route a moment after
# the command returns, a stopped unit takes a beat to leave `active` -- and a fixed
# sleep turns that into a race whose failure mode reads as "the assertion is not
# discriminating". That is the most damaging wrong answer this harness can give: it
# would send someone off to rewrite a perfectly good assertion. Waiting for the state
# to actually change, and only then judging, keeps "could not stage the break" and
# "assertion is decorative" as separate conclusions.
#
# The restore always runs, including when the assertion turns out to be weak, so one
# bad verdict cannot leave the host dirty for every control after it.
ctl() {
    local label=$1 pred=$2 brk=$3 rst=$4 budget=${5:-10}
    local i went_red=no back=no baseline=no
    # Poll the BASELINE too, not just the broken and restored states. Missing this
    # produced a spurious "baseline is already red": the control before it had
    # restarted nginx, and while the cheap gate checks answer the moment nginx is
    # back, a predicate that WRITES (registering a service) needs pfw-managed further
    # along than readyz indicates. A single sample turned "not settled yet" into a
    # reported failure -- the same mistake the broken/restored polling exists to avoid.
    # Let the SERVER settle before judging the baseline. Every entry here can restart
    # pfw-managed, and a restore that returns before the API is serving leaves the next
    # entry's baseline red through no fault of its own -- one slow recovery then cascades
    # into "baseline still red, cannot control it" for everything after it. Waiting for
    # readyz turns that cascade back into a single slow entry.
    wait_readyz 24 >/dev/null 2>&1 || true
    for ((i = 0; i < budget; i++)); do
        if eval "${pred}" >/dev/null 2>&1; then baseline=yes; break; fi
        sleep 1
    done
    if [ "${baseline}" != yes ]; then
        no "${label}: baseline still red after ${budget}s -- cannot control it"
        return 0
    fi
    # Keep the break's exit status. It used to be discarded with `|| true`, so a break
    # that FAILED to introduce the defect was indistinguishable from a predicate that
    # could not see it -- and the run blamed the predicate: "STILL GREEN with the defect
    # present -- not discriminating". That accusation sends someone to rewrite a working
    # assertion. A break that cannot run is a broken CONTROL, and says so now.
    # Keep the break's OUTPUT, not just its status. Running it under >/dev/null 2>&1
    # meant a failing break told us only "exit 1", which is not enough to fix anything --
    # the whole point of distinguishing a broken control from a weak predicate is being
    # able to act on it.
    local brk_rc=0 brk_out
    brk_out=$(eval "${brk}" 2>&1) || brk_rc=$?
    for ((i = 0; i < budget; i++)); do
        if ! eval "${pred}" >/dev/null 2>&1; then went_red=yes; break; fi
        sleep 1
    done
    if [ "${went_red}" != yes ] && [ "${brk_rc}" -ne 0 ]; then
        eval "${rst}" >/dev/null 2>&1 || true
        no "${label}: the BREAK command failed (exit ${brk_rc}) -- the control is broken, not the predicate"
        printf '        %s\n' "$(printf '%s' "${brk_out}" | tail -3)" >&2
        return 0
    fi
    eval "${rst}" >/dev/null 2>&1 || true
    for ((i = 0; i < budget; i++)); do
        if eval "${pred}" >/dev/null 2>&1; then back=yes; break; fi
        sleep 1
    done
    if [ "${went_red}" != yes ]; then
        no "${label}: STILL GREEN with the defect present -- not discriminating"
        weak=$((weak+1))
    elif [ "${back}" != yes ]; then
        no "${label}: did not recover after restore -- the control left the host dirty"
    else
        ok "${label}"
        controlled=$((controlled+1)); state_broken=$((state_broken+1))
    fi
}

# ctl_input <label> <expression-that-should-be-green> <expression-that-should-be-red>
#
# For predicates whose guarded property cannot be broken safely on a live host -- a
# read-only mount, the PostgreSQL major version -- feed the same function a known-bad
# ARGUMENT instead. This is deliberately weaker evidence and reported as [input]: it
# shows the predicate discriminates, but not that the suite aims it at the right
# target. Never let it stand in for a state break where one is possible.
ctl_input() {
    local label=$1 good=$2 bad=$3
    if ! eval "${good}" >/dev/null 2>&1; then
        no "${label}: the good input is already red -- cannot control it"
        return 0
    fi
    if eval "${bad}" >/dev/null 2>&1; then
        no "${label}: STILL GREEN on a known-bad input -- not discriminating"
        weak=$((weak+1))
        return 0
    fi
    printf '  \033[32mPASS\033[0m  %s \033[33m[input]\033[0m\n' "${label}"
    pass=$((pass+1)); controlled=$((controlled+1)); input_fed=$((input_fed+1))
}

# ---------------------------------------------------------------- break helpers
# Two breaks need quoting three layers deep -- ctl evals the string, inc hands it to
# `bash -c` inside the container, and the command itself then parses SQL or a shell
# assignment. Written inline in a ctl argument, each escape level is a place to get it
# silently wrong, and a break that fails is reported as "the assertion is not
# discriminating", which is the most damaging wrong answer this harness can give.

# `grafana cli` opens Grafana's database ITSELF, using --config=/etc/grafana/pfw.ini,
# whose [database] password the RPM ships empty -- the real value reaches Grafana as
# GF_DATABASE_PASSWORD from pfw-grafana.service. `docker exec` starts a bare shell with
# none of that unit's environment, so the credential has to be supplied here or every
# admin-password break and restore fails to connect.
set_grafana_admin_pw() {
    inc "GF_DATABASE_PASSWORD=\$(sed -n 's/^GF_DATABASE_PASSWORD=//p' /srv/.pfw-secrets/grafana.env) /usr/sbin/grafana cli --config=/etc/grafana/pfw.ini --homepath /usr/share/grafana admin reset-admin-password $1"
    # Clear Grafana's brute-force lockout. Controlling p_generated_admin_works means
    # deliberately authenticating with a wrong password, and after five such attempts
    # Grafana locks the admin account for its lockout window. The restore then sets the
    # RIGHT password and still gets 401, so the suite reported "left red on the airgap
    # host" and every later probe -- including api-tests against the same server -- kept
    # failing on a password that was, in fact, correct. Resetting the password does not
    # clear the counter; only this does.
    inc "PGPASSWORD=\$(cat /srv/.postgres_password) psql -U postgres -h /run/postgresql -d grafana -c 'DELETE FROM login_attempt' >/dev/null"
}

# Repoint the pmm-managed role's password as the postgres superuser.
set_managed_role_pw() {
    inc "PGPASSWORD=\$(cat /srv/.postgres_password) psql -U postgres -h /run/postgresql -d postgres -c \"ALTER USER \\\"pmm-managed\\\" WITH PASSWORD '$1'\""
}

# ------------------------------------------------------------------- canary package
# Built once, before either phase: both need it -- the airgap phase to mix an unsigned
# package into a directory of signed ones, the upgrade phase to make a pmm-* package
# exist. It is deliberately never signed.
canary_rpm=${scratch}/pmm-nc-canary-0-0.noarch.rpm
build_canary_rpm() {
    cat > "${scratch}/pmm-nc-canary.spec" <<'EOF'
Name:           pmm-nc-canary
Version:        0
Release:        0
Summary:        negative-control canary
License:        AGPLv3
BuildArch:      noarch
%description
Exists only so the "no pmm-* packages" assertion has something to find, and so the
all-packages-signed assertion has an unsigned package to refuse.
%files
EOF
    # chown back to the caller: rpmbuild runs as root in the container, and without
    # this the EXIT trap cannot remove its own scratch directory.
    docker run --rm -v "${scratch}":/s -w /s "${PFW_RPMBUILD_IMAGE}" \
        sh -c "rpmbuild --define '_topdir /s/top' -bb pmm-nc-canary.spec >/dev/null 2>&1 \
               && cp /s/top/RPMS/noarch/*.rpm /s/ && chown -R ${host_uid}:${host_gid} /s" \
        || die "could not build the pmm-* canary package"
    [ -f "${canary_rpm}" ] || die "canary package did not appear at ${canary_rpm}"
}

# ---------------------------------------------------------------------- preflight

# Point every subsequent predicate at a specific host. ${container} is what inc()
# execs into, so reassigning it switches phases.
require_container() {
    container=$1
    docker inspect "${container}" >/dev/null 2>&1 \
        || die "no container ${container}; run $2 first (it keeps the host by default)"
    [ "$(docker inspect -f '{{.State.Running}}' "${container}")" = true ] \
        || die "container ${container} is not running"
    [ "$(wait_readyz 12)" = "200" ] \
        || die "${container} is not healthy (readyz != 200); re-run $2"
}

phase_upgrade() {
    require_container "${upgrade_container}" build/scripts/test-pfw-upgrade
    printf '\nControlling test-pfw-upgrade assertions against %s\n' "${container}"

    # Re-assert the UPGRADE host's credential. SRV and ADMIN_PW are globals, and in
    # `both` mode phase_airgap runs first and calls set_srv_from_secrets, which points
    # them at the AIRGAP host's generated password. Everything here then authenticates to
    # the upgrade host with the wrong host's credential and gets 401 -- which surfaced as
    # "the BREAK command failed", one line of stderr saying "Invalid username or
    # password". admin:admin is correct here because relocation does not rotate the
    # Grafana admin user, exactly as pfw-test-lib documents.
    SRV="--server-url=https://admin:admin@127.0.0.1:8443 --server-insecure-tls"
    ADMIN_PW=admin

    # ------------------------------------------------------------------ pure predicate

    hdr "package-upgrade comparison (no container needed)"
    # The defect is a release string that never advances, so dnf skips the package in
    # silence. Feed the comparison two identical listings: it must report every package
    # as stuck, or it would report a skipped upgrade as a success.
    # CURRENT package names. These fixtures still said pfw-client, pfm-grafana,
    # pfm-managed, pfm-server and percona-dashboards -- all renamed. stuck_pkgs compares
    # per package, so names that no longer exist matched nothing and the control could
    # not tell "everything moved" from "nothing moved": it reported the predicate broken
    # while the predicate was fine.
    # ALL EIGHT packages stuck_pkgs iterates. A package absent from both fixtures reads
    # as "did not move" -- correctly, because that strictness is what caught pfw-dump
    # never being installed at all. So the fixtures have to be complete, not the
    # predicate loosened.
    same=$'pfw-agent-3.9.0-1.a\npfw-grafana-1-1.a\npfw-managed-3.9.0-1.a\npfw-server-3.9.0-1.a\npfw-dashboards-3.9.0-1.a\npfw-qan-api2-3.9.0-1.a\npfw-vmproxy-3.9.0-1.a\npfw-dump-3.9.0-1.a'
    diff=$'pfw-agent-3.9.0-2.b\npfw-grafana-1-2.b\npfw-managed-3.9.0-2.b\npfw-server-3.9.0-2.b\npfw-dashboards-3.9.0-2.b\npfw-qan-api2-3.9.0-2.b\npfw-vmproxy-3.9.0-2.b\npfw-dump-3.9.0-2.b'
    if p_all_pkgs_upgraded "${same}" "${same}"; then
        no "p_all_pkgs_upgraded: reports success when nothing moved"; weak=$((weak+1))
    elif ! p_all_pkgs_upgraded "${same}" "${diff}"; then
        no "p_all_pkgs_upgraded: reports failure when everything moved"
    else
        ok "p_all_pkgs_upgraded (red on identical NEVRAs, green when all five advance)"
        controlled=$((controlled+1)); state_broken=$((state_broken+1))
    fi
    # A partial skip is the realistic shape: four move, one does not.
    partial=$'pfw-agent-3.9.0-2.b\npfw-grafana-1-2.b\npfw-managed-3.9.0-2.b\npfw-server-3.9.0-1.a\npfw-dashboards-3.9.0-2.b\npfw-qan-api2-3.9.0-2.b\npfw-vmproxy-3.9.0-2.b\npfw-dump-3.9.0-2.b'
    if p_all_pkgs_upgraded "${same}" "${partial}"; then
        no "p_all_pkgs_upgraded: misses a single skipped package"; weak=$((weak+1))
    else
        ok "p_all_pkgs_upgraded (red when only one package is skipped)"
        controlled=$((controlled+1)); state_broken=$((state_broken+1))
    fi

    # ------------------------------------------------------------- credential relocation

    hdr "credential relocation"
    # Restore what was actually there, read off the host before the break. The value IS
    # "pmm-managed" on an upgraded host today, but a hardcoded restore plants that
    # constant the moment relocation ever preserves anything else -- and it would do so
    # while reporting a pass.
    local relocated_pw
    relocated_pw=$(secret_val /srv/.pfw-secrets/managed-db.env PMM_POSTGRES_DBPASSWORD)
    if [ -z "${relocated_pw}" ]; then
        skip "p_secrets_relocated -- cannot read the pre-break value, refusing to restore a guess"
    else
        # EMPTY the file rather than rewrite its value. p_secrets_relocated asserts the
        # property -- a non-empty 0600 secret -- not a particular password, because on a
        # supported upgrade the password is generated. Writing a different value leaves
        # the property intact, so that break would not go red and the control would
        # report a passing predicate it never actually falsified.
        ctl "p_secrets_relocated (empty the secret file)" \
            "p_secrets_relocated" \
            "inc \": > /srv/.pfw-secrets/managed-db.env\"" \
            "inc \"printf 'PMM_POSTGRES_DBPASSWORD=${relocated_pw}\\n' > /srv/.pfw-secrets/managed-db.env; chmod 600 /srv/.pfw-secrets/managed-db.env\"" 3
    fi

    ctl "p_upgraded_unit_clean (put a literal back in the unit)" \
        "p_upgraded_unit_clean" \
        "inc \"printf 'Environment=PMM_POSTGRES_DBPASSWORD=pmm-managed\\n' >> /usr/lib/systemd/system/pfw-managed.service\"" \
        "inc \"sed -i '/^Environment=PMM_POSTGRES_DBPASSWORD=/d' /usr/lib/systemd/system/pfw-managed.service\"" 3

    # --------------------------------------------------------------- host / networking

    hdr "host isolation"
    ctl "p_no_internet (attach the host to a routed network)" \
        "p_no_internet" \
        "docker network connect bridge ${container}" \
        "docker network disconnect bridge ${container}" 30

    # ------------------------------------------------------------------- server health

    hdr "server health"
    ctl "p_readyz (stop pfw-managed)" \
        "p_readyz" \
        "inc 'systemctl stop pfw-managed'" \
        "inc 'systemctl start pfw-managed'; wait_readyz 24 >/dev/null" 120

    ctl "p_no_failed_units (introduce a failing pfw unit)" \
        "p_no_failed_units" \
        "inc \"printf '[Unit]\nDescription=negative control\n[Service]\nType=oneshot\nExecStart=/bin/false\n' > /etc/systemd/system/pfw-nc-canary.service; systemctl daemon-reload; systemctl start pfw-nc-canary.service\"" \
        "inc 'systemctl reset-failed pfw-nc-canary.service; rm -f /etc/systemd/system/pfw-nc-canary.service; systemctl daemon-reload'" 3

    ctl "p_all_units_active (stop pfw-vmalert)" \
        "p_all_units_active" \
        "inc 'systemctl stop pfw-vmalert'" \
        "inc 'systemctl start pfw-vmalert'" 30

    # --------------------------------------------------------------------- data stores

    hdr "data survival (one control per store)"
    # 20s, not 4: the RESTORE here is a write, and `pfw-admin add postgresql` does real
    # work before the service appears in the inventory -- it probes for pg_stat_monitor,
    # falls back to pg_stat_statements, and sets up an exporter agent. Observed failing at
    # 4s ("did not recover after restore -- the control left the host dirty", plus a
    # knock-on "left red on the upgrade host"), while the identical command run by hand
    # immediately afterwards succeeded. That is the exact flake this file's own ctl header
    # warns about: a predicate that WRITES needs pfw-managed further along than readyz
    # indicates. Two reported failures from one under-tuned budget, and each costs someone
    # a fresh investigation to re-discover it is not a real defect.
    ctl "p_service_registered (deregister the monitored service)" \
        "p_service_registered" \
        "inc \"/usr/sbin/pfw-admin ${SRV} remove postgresql canary-pg\"" \
        "inc \"/usr/sbin/pfw-admin ${SRV} add postgresql --host=127.0.0.1 --port=5432 --username=postgres --password=\\\$(cat /srv/.postgres_password) canary-pg\"" 20

    ctl "p_grafana_folder (delete the folder)" \
        "p_grafana_folder" \
        "inc \"uid=\\\$(curl -sk -u admin:admin 'https://127.0.0.1:8443/graph/api/search?query=upgrade-canary' | grep -o '\\\"uid\\\":\\\"[^\\\"]*\\\"' | head -1 | cut -d'\\\"' -f4); curl -sk -u admin:admin -X DELETE https://127.0.0.1:8443/graph/api/folders/\\\$uid\"" \
        "gapi \"-X POST -H 'Content-Type: application/json' -d '{\\\"title\\\":\\\"upgrade-canary\\\"}' https://127.0.0.1:8443/graph/api/folders\"" 3

    ctl "p_clickhouse_row (drop the table)" \
        "p_clickhouse_row" \
        "ch 'DROP TABLE default.pfw_upgrade_canary'" \
        "ch 'CREATE TABLE IF NOT EXISTS default.pfw_upgrade_canary (n UInt8) ENGINE = MergeTree ORDER BY n'; ch 'INSERT INTO default.pfw_upgrade_canary VALUES (42)'" 3

    # Metrics have no safe "break" -- deleting the TSDB is not reversible -- so control
    # the predicate's sensitivity instead: it must find data at a timestamp inside the
    # retention window and find none well before this host existed.
    hdr "metrics history"
    now=$(inc 'date +%s')
    long_ago=$((now - 2592000))
    if ! p_metrics_at "$((now - 60))"; then
        no "p_metrics_at: no data at a timestamp inside the window -- baseline is red"
    elif p_metrics_at "${long_ago}"; then
        no "p_metrics_at: STILL GREEN 30 days before this host existed -- it ignores the timestamp"
        weak=$((weak+1))
    else
        ok "p_metrics_at (green inside the window, red 30 days before the host existed) [input]"
        controlled=$((controlled+1)); input_fed=$((input_fed+1))
    fi

    # ------------------------------------------------------------------- configuration

    hdr "configuration was not reverted"
    ctl "p_pfm_ini_plugins (comment out paths.plugins)" \
        "p_pfm_ini_plugins" \
        "inc \"sed -i 's|^plugins = |#plugins = |' /etc/grafana/pfw.ini\"" \
        "inc \"sed -i 's|^#plugins = |plugins = |' /etc/grafana/pfw.ini\"" 2

    ctl "p_pfm_ini_loopback (comment out http_addr)" \
        "p_pfm_ini_loopback" \
        "inc \"sed -i 's|^http_addr = |#http_addr = |' /etc/grafana/pfw.ini\"" \
        "inc \"sed -i 's|^#http_addr = |http_addr = |' /etc/grafana/pfw.ini\"" 2

    # rmdir, not rm -rf: it removes only an empty directory, so a mistake here cannot
    # destroy anything.
    ctl "p_no_srv_plugin_copy (create the first-boot copy directory)" \
        "p_no_srv_plugin_copy" \
        "inc 'mkdir -p /srv/grafana/plugins'" \
        "inc 'rmdir /srv/grafana/plugins'" 2

    ctl "p_operator_edit_kept (remove the operator's line)" \
        "p_operator_edit_kept" \
        "inc \"sed -i '/^# operator-canary/d' /etc/nginx/pfw.conf\"" \
        "inc \"printf '# operator-canary\n' >> /etc/nginx/pfw.conf\"" 2

    # Grafana already holds 127.0.0.1:3000, so an off-host listener cannot bind until it
    # lets go -- hence stopping it. This is the slowest control in the set.
    #
    # The pattern is '[h]ttp\.server', not 'http.server': pkill -f matches against whole
    # command lines, including the `bash -c` this very command runs in, so the plain
    # spelling makes pkill kill its own shell before `systemctl start` executes. That
    # happened -- grafana stayed down and every control after it inherited a broken host.
    # The bracket makes the regex match the running python but not this command line.
    hdr "network exposure"
    ctl "p_grafana_not_exposed (bind 0.0.0.0:3000)" \
        "p_grafana_not_exposed" \
        "inc 'systemctl stop pfw-grafana; setsid nohup python3 -m http.server 3000 --bind 0.0.0.0 >/dev/null 2>&1 < /dev/null & sleep 2'" \
        "inc \"pkill -f '[h]ttp\\.server' || true; systemctl start pfw-grafana\"; wait_readyz 36 >/dev/null" 180

    # ------------------------------------------------------------------- gate / naming

    hdr "gate and packaging"
    # This controls the ASSERTION, not the gate: it proves the check reads the server's
    # real answer rather than matching unconditionally. Proving the gate itself would
    # need a build with the gate removed, which is a different test.
    ctl "p_mysql_rejected (make the server unreachable so the answer changes)" \
        "p_mysql_rejected" \
        "inc 'systemctl stop pfw-managed'" \
        "inc 'systemctl start pfw-managed'; wait_readyz 24 >/dev/null" 120
    note "that controls the assertion's dependence on the response, not the gate itself"

    # A package literally named pmm-* is the thing this guards against, so install one.
    hdr "no pmm-* packages"
    docker cp "${canary_rpm}" "${container}:/tmp/" >/dev/null
    ctl "p_no_pmm_packages (install a package named pmm-*)" \
        "p_no_pmm_packages" \
        "inc 'rpm -i --nodeps /tmp/pmm-nc-canary-0-0.noarch.rpm'" \
        "inc 'rpm -e pmm-nc-canary'" 2

    # ---------------------------------------------------------------------- clickhouse

    hdr "clickhouse ownership (the defect-4 assertions)"
    ch_break="inc 'chown -R clickhouse:clickhouse /etc/clickhouse-server'"
    ch_fix="inc 'chown -R pfw:pfw /etc/clickhouse-server; chmod -R u+rwX /etc/clickhouse-server'"
    ctl "p_ch_owned_by_pfm (chown back to clickhouse)" "p_ch_owned_by_pfm" "${ch_break}" "${ch_fix}" 2
    ctl "p_ch_config_readable (chown back to clickhouse)" "p_ch_config_readable" "${ch_break}" "${ch_fix}" 2
    # The mirror image: this one asserts ownership WAS reverted, so its healthy baseline
    # is red. Control it in the opposite direction.
    if p_ch_owner_reverted; then
        no "p_ch_owner_reverted: green while ownership is correct -- it would always fire"
        weak=$((weak+1))
    else
        eval "${ch_break}" >/dev/null 2>&1 || true
        sleep 2
        if p_ch_owner_reverted; then
            ok "p_ch_owner_reverted (red when pfw-owned, green once reverted)"
            controlled=$((controlled+1)); state_broken=$((state_broken+1))
        else
            no "p_ch_owner_reverted: did not notice a real revert"
            weak=$((weak+1))
        fi
        eval "${ch_fix}" >/dev/null 2>&1 || true
    fi

    # ------------------------------------------------------------------ not controlled

    hdr "controlled by the upgrade run itself"
    note "p_marker_served is asserted GREEN before the upgrade and RED after it, on the same"
    note "predicate in the same run -- a two-sided control that needs no staging here."

    hdr "not controlled, with reasons"
    skip "'dnf upgrade completed offline' -- it IS the exit status of the operation under test; there is no state in which a failed upgrade reports success"
    skip "'previous release is up' and 'metrics are flowing' -- same predicates as p_readyz / p_metrics_at, already controlled above"
    skip "the seeding assertions -- they call p_service_registered / p_grafana_folder / p_clickhouse_row / p_operator_edit_kept, all controlled above"


    hdr "leaving the host as we found it"
    local final_bad="" q
    for q in p_readyz p_no_failed_units p_all_units_active p_service_registered \
             p_grafana_folder p_clickhouse_row p_pfm_ini_plugins p_pfm_ini_loopback \
             p_no_srv_plugin_copy p_grafana_not_exposed p_operator_edit_kept \
             p_no_pmm_packages p_ch_owned_by_pfm p_ch_config_readable; do
        eval "${q}" >/dev/null 2>&1 || final_bad="${final_bad} ${q}"
    done
    [ -z "${final_bad}" ] && ok "every upgrade-host predicate green again" \
        || no "left red on the upgrade host:${final_bad}"
}

# ============================================================== airgap suite phase

phase_airgap() {
    require_container "${airgap_container}" build/scripts/test-pfw-airgap
    printf '\nControlling test-pfw-airgap assertions against %s\n' "${container}"
    set_srv_from_secrets

    hdr "host realism"
    # Disconnecting the only network removes the global-scope address entirely. The
    # services all bind loopback, so readyz survives it.
    ctl "p_has_nic (detach the host from its network)" \
        "p_has_nic" \
        "docker network disconnect ${network} ${container}" \
        "docker network connect ${network} ${container}" 30

    hdr "the gate"
    # nginx, not pfw-managed: stopping the proxy changes pfw-admin's answer in one
    # second and comes back in one, where a pfw-managed restart costs two minutes.
    # Either proves the assertion reads the server's real response.
    local nginx_break="inc 'systemctl stop pfw-nginx'"
    local nginx_fix="inc 'systemctl start pfw-nginx'; wait_readyz 24 >/dev/null"
    ctl "p_mongodb_rejected (stop nginx so the answer changes)" \
        "p_mongodb_rejected" "${nginx_break}" "${nginx_fix}" 60
    ctl "p_postgresql_accepted (stop nginx so the answer changes)" \
        "p_postgresql_accepted" "${nginx_break}" "${nginx_fix}" 60
    note "p_postgresql_accepted registers a uniquely-named service on each call, so"
    note "this control leaves a few extra services behind on the throwaway host"

    hdr "advisor family gate"
    # A real state break using the product's own supported override: widening
    # PFW_DB_TYPES must make the MySQL/MongoDB advisor checks reappear. That proves the
    # advisor filter reads the same allowlist as the Service gate rather than carrying a
    # second hardcoded copy of it.
    ctl "p_advisors_pg_only (widen PFW_DB_TYPES to admit mysql/mongodb)" \
        "p_advisors_pg_only" \
        "inc \"mkdir -p /etc/systemd/system/pfw-managed.service.d && printf '[Service]\\nEnvironment=PFW_DB_TYPES=postgresql,mysql,mongodb,haproxy,external\\n' > /etc/systemd/system/pfw-managed.service.d/nc-widen.conf && systemctl daemon-reload && systemctl restart pfw-managed\"" \
        "inc 'rm -f /etc/systemd/system/pfw-managed.service.d/nc-widen.conf; systemctl daemon-reload; systemctl restart pfw-managed'; wait_readyz 36 >/dev/null" 180

    hdr "branding and UI"
    ctl "p_grafana_title (stop grafana)" \
        "p_grafana_title" \
        "inc 'systemctl stop pfw-grafana'" \
        "inc 'systemctl start pfw-grafana'; wait_readyz 36 >/dev/null" 180
    ctl "p_pfmui_title (stop nginx)" \
        "p_pfmui_title" "${nginx_break}" "${nginx_fix}" 60

    hdr "data flowing"
    ctl "p_pg_up (stop victoriametrics)" \
        "p_pg_up" \
        "inc 'systemctl stop pfw-victoriametrics'" \
        "inc 'systemctl start pfw-victoriametrics'" 60
    ctl "p_dashboards (stop grafana)" \
        "p_dashboards" \
        "inc 'systemctl stop pfw-grafana'" \
        "inc 'systemctl start pfw-grafana'; wait_readyz 36 >/dev/null" 180
    # Stopping PostgreSQL would only show the check reads live state; feeding it a
    # major the server is not running is what proves the comparison discriminates.
    ctl_input "p_postgres_major (expect a version the server is not running)" \
        "p_postgres_major 18" "p_postgres_major 99"

    hdr "signing"
    ctl_input "p_bundle_signed (point at a directory with no key)" \
        "p_bundle_signed ${bundle}" "p_bundle_signed /tmp"
    # A directory holding one properly signed package plus an unsigned one: the
    # all-signed check must refuse it.
    # The canary built for the pmm-* control is never signed, which is exactly what is
    # needed here: one properly signed package plus one unsigned one in a directory.
    if docker cp "${canary_rpm}" "${container}:/tmp/nc-unsigned.rpm" >/dev/null 2>&1 \
       && inc "rm -rf /tmp/nc-repo && mkdir -p /tmp/nc-repo && cp ${bundle}/pfw-server-*.rpm /tmp/nc-repo/ && cp /tmp/nc-unsigned.rpm /tmp/nc-repo/"; then
        ctl_input "p_all_rpms_signed (a directory containing one unsigned package)" \
            "p_all_rpms_signed ${bundle}" "p_all_rpms_signed /tmp/nc-repo"
    else
        skip "p_all_rpms_signed -- could not stage an unsigned package to mix in"
    fi
    # Two-sided by construction: the suite tampers with a copy and expects failure,
    # which only means something if the untampered copy still verifies.
    inc "cp ${bundle}/pfw-server-*.rpm /tmp/nc-good.rpm && cp /tmp/nc-good.rpm /tmp/nc-bad.rpm && printf '\\x00\\x00\\x00\\x00' | dd of=/tmp/nc-bad.rpm bs=1 seek=6000 conv=notrunc status=none" >/dev/null 2>&1 || true
    ctl_input "p_rpm_verifies (a tampered copy of a signed package)" \
        "p_rpm_verifies /tmp/nc-good.rpm" "p_rpm_verifies /tmp/nc-bad.rpm"

    hdr "network exposure"
    ctl "p_no_unexpected_listeners (bind 0.0.0.0:9999)" \
        "p_no_unexpected_listeners" \
        "inc 'setsid nohup python3 -m http.server 9999 --bind 0.0.0.0 >/dev/null 2>&1 </dev/null & sleep 2'" \
        "inc \"pkill -f '[h]ttp\\.server 9999' || true\"" 30

    hdr "upgrade-safety structure"
    # Editing the unit file is enough: the predicate greps the file, so no reload or
    # grafana restart is needed and the control stays cheap.
    ctl "p_grafana_uses_pfm_ini (point the unit at another config)" \
        "p_grafana_uses_pfm_ini" \
        "inc \"sed -i 's|--config=/etc/grafana/pfw.ini|--config=/etc/grafana/nc.ini|' /usr/lib/systemd/system/pfw-grafana.service\"" \
        "inc \"sed -i 's|--config=/etc/grafana/nc.ini|--config=/etc/grafana/pfw.ini|' /usr/lib/systemd/system/pfw-grafana.service\"" 10
    ctl_input "p_owned_by_pfm_server (a path pfw-server does not own)" \
        "p_owned_by_pfm_server /etc/grafana/pfw.ini" "p_owned_by_pfm_server /etc/hosts"
    # Masking is not enough -- `systemctl cat` still prints the /dev/null link -- so
    # the unit file has to move out of the way.
    ctl "p_ch_perms_unit (move the unit file aside)" \
        "p_ch_perms_unit" \
        "inc 'mv /usr/lib/systemd/system/pfw-clickhouse-perms.service /tmp/nc-perms.service; systemctl daemon-reload'" \
        "inc 'mv /tmp/nc-perms.service /usr/lib/systemd/system/pfw-clickhouse-perms.service; systemctl daemon-reload'" 20
    ctl "p_ch_requires_perms (comment out the Requires= line)" \
        "p_ch_requires_perms" \
        "inc \"sed -i 's|^Requires=pfw-clickhouse-perms.service|#NC&|' /usr/lib/systemd/system/pfw-clickhouse.service; systemctl daemon-reload\"" \
        "inc \"sed -i 's|^#NCRequires=pfw-clickhouse-perms.service|Requires=pfw-clickhouse-perms.service|' /usr/lib/systemd/system/pfw-clickhouse.service; systemctl daemon-reload\"" 20
    # Drop the ExecStartPre via a drop-in. An empty ExecStartPre= resets the list, which
    # is exactly how someone would accidentally remove it.
    ctl "p_nginx_relabels_cert_dir (drop the restorecon ExecStartPre)" \
        "p_nginx_relabels_cert_dir" \
        "inc 'mkdir -p /etc/systemd/system/pfw-nginx.service.d; printf \"[Service]\\nExecStartPre=\\n\" > /etc/systemd/system/pfw-nginx.service.d/99-nc.conf; systemctl daemon-reload'" \
        "inc 'rm -rf /etc/systemd/system/pfw-nginx.service.d; systemctl daemon-reload'" 10
    # Drop RuntimeDirectory via a drop-in. Deleting /run/clickhouse-server instead
    # would NOT go red: the predicate asserts the unit's declaration, which is the
    # property that makes the deletion survivable.
    ctl "p_ch_runtime_dir_guaranteed (drop RuntimeDirectory= from the unit)" \
        "p_ch_runtime_dir_guaranteed" \
        "inc 'mkdir -p /etc/systemd/system/pfw-clickhouse.service.d; printf \"[Service]\\nRuntimeDirectory=\\n\" > /etc/systemd/system/pfw-clickhouse.service.d/99-nc.conf; systemctl daemon-reload'" \
        "inc 'rm -rf /etc/systemd/system/pfw-clickhouse.service.d; systemctl daemon-reload'" 10
    # Move the module aside rather than truncating it: the predicate tests -s, so an
    # empty file would also go red and would not prove it checks the right path.
    ctl "p_selinux_module_shipped (move the .pp aside)" \
        "p_selinux_module_shipped" \
        "inc 'mv /usr/share/selinux/packages/pfw_nginx.pp /tmp/nc-pfw_nginx.pp'" \
        "inc 'mv /tmp/nc-pfw_nginx.pp /usr/share/selinux/packages/pfw_nginx.pp'" 5
    # Break it the way reality would: an upstream clickhouse %post that grants one more
    # capability than our unit covers. Breaking the binary rather than the unit is the
    # faithful direction -- the unit is ours to keep correct, the binary is not.
    ctl "p_ch_caps_within_bounding_set (grant the binary an uncovered capability)" \
        "p_ch_caps_within_bounding_set" \
        "inc 'setcap cap_sys_admin,cap_net_bind_service,cap_net_admin,cap_ipc_lock,cap_sys_nice=ep /usr/bin/clickhouse'" \
        "inc 'setcap cap_net_bind_service,cap_net_admin,cap_ipc_lock,cap_sys_nice=ep /usr/bin/clickhouse'" 20

    hdr "build-stamped releases"
    # A package whose Release is literally 1.el9 -- the exact shape that made dnf skip
    # our packages in silence.
    cat > "${scratch}/pfw-nc-static.spec" <<'EOF'
Name:           pfw-nc-static
Version:        0
Release:        1%{?dist}
Summary:        negative-control canary with a static release
License:        AGPLv3
BuildArch:      noarch
%description
Its Release is literally 1.el9, which is what dnf silently refuses to upgrade.
%files
EOF
    if docker run --rm -v "${scratch}":/s -w /s "${PFW_RPMBUILD_IMAGE}" \
        sh -c "rpmbuild --define '_topdir /s/top2' --define 'dist .el9' -bb pfw-nc-static.spec >/dev/null 2>&1 \
               && cp /s/top2/RPMS/noarch/*.rpm /s/ && chown -R ${host_uid}:${host_gid} /s" \
        && docker cp "${scratch}/pfw-nc-static-0-1.el9.noarch.rpm" "${container}:/tmp/" >/dev/null 2>&1 \
        && inc 'rpm -i --nodeps /tmp/pfw-nc-static-0-1.el9.noarch.rpm'; then
        ctl_input "p_release_stamped (a package whose release is literally 1.el9)" \
            "p_release_stamped pfw-server" "p_release_stamped pfw-nc-static"
        inc 'rpm -e pfw-nc-static' >/dev/null 2>&1 || true
    else
        skip "p_release_stamped -- could not build/install a static-release canary"
    fi

    hdr "bootstrap credentials"
    ctl "p_secrets_dir_perms (widen the directory)" \
        "p_secrets_dir_perms" \
        "inc 'chmod 755 /srv/.pfw-secrets'" \
        "inc 'chmod 700 /srv/.pfw-secrets'" 3

    ctl "p_secret_files_0600 (widen a secret file)" \
        "p_secret_files_0600" \
        "inc 'chmod 644 /srv/.pfw-secrets/managed-db.env'" \
        "inc 'chmod 600 /srv/.pfw-secrets/managed-db.env'" 3

    ctl "p_no_secret_in_units (put a literal back in a unit)" \
        "p_no_secret_in_units" \
        "inc \"printf 'Environment=PMM_POSTGRES_DBPASSWORD=pmm-managed\\n' >> /usr/lib/systemd/system/pfw-managed.service\"" \
        "inc \"sed -i '/^Environment=PMM_POSTGRES_DBPASSWORD=/d' /usr/lib/systemd/system/pfw-managed.service\"" 3

    ctl_input "p_managed_pw_generated (feed it the value that IS in the file)" \
        "p_managed_pw_generated" \
        "p_managed_pw_generated \"\$(secret_val /srv/.pfw-secrets/managed-db.env PMM_POSTGRES_DBPASSWORD)\""

    # The marker is what makes losing /srv/.pfw-secrets fatal instead of silently
    # repaired with the shipped constant, so its absence has to be visible.
    ctl "p_secrets_marker (remove the generation marker)" \
        "p_secrets_marker" \
        "inc 'mv /srv/pfw-secrets-generated /srv/pfw-secrets-generated.nc'" \
        "inc 'mv /srv/pfw-secrets-generated.nc /srv/pfw-secrets-generated'" 3

    # A real state break for the pair that guards the DATABASE credential: put the
    # legacy password back on the role and require both halves to notice -- the
    # rejection must go red, and so must the acceptance of the generated value. The
    # generated password is read ONCE, up front: if it cannot be read there is nothing
    # to restore the role to, and an ALTER we cannot undo would leave the host wedged.
    local gen_db_pw
    gen_db_pw=$(secret_val /srv/.pfw-secrets/managed-db.env PMM_POSTGRES_DBPASSWORD)
    if [ -z "${gen_db_pw}" ]; then
        skip "p_legacy_db_rejected / p_generated_db_works -- cannot read the generated password, refusing an ALTER I cannot undo"
    else
        ctl "p_legacy_db_rejected (put the legacy password back on the role)" \
            "p_legacy_db_rejected" \
            "set_managed_role_pw pmm-managed" \
            "set_managed_role_pw '${gen_db_pw}'" 10
        ctl "p_generated_db_works (take the generated password off the role)" \
            "p_generated_db_works" \
            "set_managed_role_pw pmm-managed" \
            "set_managed_role_pw '${gen_db_pw}'" 10
    fi

    # Same symmetric treatment for the ADMIN credential. Both halves run through
    # set_grafana_admin_pw, which supplies the DB password `grafana cli` needs: without
    # it the break and the restore both fail to connect, ctl swallows them (they run
    # under `|| true`) and reports "STILL GREEN with the defect present -- not
    # discriminating" -- the exact false verdict this harness exists to prevent, aimed
    # at a perfectly good assertion.
    local gen_admin_pw
    gen_admin_pw=$(secret_val /srv/.pfw-secrets/grafana.env GF_SECURITY_ADMIN_PASSWORD)
    if [ -z "${gen_admin_pw}" ]; then
        skip "p_admin_admin_rejected / p_generated_admin_works -- cannot read the generated admin password"
    else
        ctl "p_admin_admin_rejected (reset the admin password back to admin)" \
            "p_admin_admin_rejected" \
            "set_grafana_admin_pw admin" \
            "set_grafana_admin_pw '${gen_admin_pw}'" 10
        ctl "p_generated_admin_works (change the admin password out from under it)" \
            "p_generated_admin_works" \
            "set_grafana_admin_pw nc-not-the-generated-password" \
            "set_grafana_admin_pw '${gen_admin_pw}'" 10
    fi

    ctl_input "p_grafana_pw_generated (feed it the value that IS in the file)" \
        "p_grafana_pw_generated" \
        "p_grafana_pw_generated \"\$(secret_val /srv/.pfw-secrets/grafana.env GF_DATABASE_PASSWORD)\""

    # The two "no shipped file carries a password" assertions. Both are `!`-inverted or
    # match-a-blank-line, so both pass vacuously on a file that is missing or shaped
    # differently; putting the credential back is the only way to show they look at it.
    ctl "p_no_pw_in_grafana_ini (write a password back into pfw.ini)" \
        "p_no_pw_in_grafana_ini" \
        "inc \"sed -i 's/^password *= *\$/password = grafana/' /etc/grafana/pfw.ini\"" \
        "inc \"sed -i 's/^password = grafana\$/password =/' /etc/grafana/pfw.ini\"" 3

    ctl "p_no_pw_in_env_seed (put the constant back in the packaged seed)" \
        "p_no_pw_in_env_seed" \
        "inc \"printf 'PMM_POSTGRES_DBPASSWORD=pmm-managed\\n' >> /usr/lib/pfw/defaults/grafana.env\"" \
        "inc \"sed -i '/^PMM_POSTGRES_DBPASSWORD=pmm-managed\$/d' /usr/lib/pfw/defaults/grafana.env\"" 3

    hdr "leaving the host as we found it"
    local final_bad="" q
    for q in p_readyz p_no_failed_units p_all_units_active p_has_nic p_grafana_title \
             p_advisors_pg_only \
             p_secrets_marker p_legacy_db_rejected p_generated_db_works \
             p_admin_admin_rejected p_generated_admin_works \
             p_no_pw_in_grafana_ini p_no_pw_in_env_seed \
             p_pfmui_title p_pg_up p_dashboards p_no_unexpected_listeners \
             p_grafana_uses_pfm_ini p_ch_perms_unit p_ch_requires_perms \
             p_no_pmm_packages p_ch_owned_by_pfm p_ch_caps_within_bounding_set \
             p_selinux_module_shipped p_ch_runtime_dir_guaranteed \
             p_nginx_relabels_cert_dir; do
        eval "${q}" >/dev/null 2>&1 || final_bad="${final_bad} ${q}"
    done
    [ -z "${final_bad}" ] && ok "every airgap-host predicate green again" \
        || no "left red on the airgap host:${final_bad}"
}

# ===================================================================== dispatcher

build_canary_rpm

case "${phase}" in
    upgrade) phase_upgrade ;;
    airgap)  phase_airgap ;;
    both)    phase_airgap; phase_upgrade ;;
    *)       die "usage: test-pfw-negative-control [airgap|upgrade|both]" ;;
esac

if [ "${phase}" = airgap ]; then
    note "only the airgap suite was controlled; the predicates shared with the upgrade"
    note "suite (p_readyz, p_no_failed_units, p_mysql_rejected, ...) are controlled in"
    note "the upgrade phase, so run 'both' for full coverage"
elif [ "${phase}" = upgrade ]; then
    note "only the upgrade suite was controlled; the airgap-specific predicates"
    note "(branding, signing, exposure, PG major, ...) are controlled in the airgap phase"
fi

printf '\n%s controlled (%s by breaking real state, %s by known-bad input), %s not discriminating, %s skipped\n' \
    "${controlled}" "${state_broken}" "${input_fed}" "${weak}" "${skipped}"
# The classes must account for every control. An unclassified one silently inflates the
# headline number while under-reporting how it was established, which is the exact
# distinction this harness exists to make.
if [ "$((state_broken + input_fed))" -ne "${controlled}" ]; then
    no "tally does not reconcile: ${state_broken} state + ${input_fed} input != ${controlled} controlled"
fi
printf '%s passed, %s failed\n' "${pass}" "${fail}"
[ "${fail}" -eq 0 ]
